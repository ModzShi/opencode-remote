<svg xmlns="http://www.w3.org/2000/svg" width="1024" height="1024" viewBox="0 0 1024 1024">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0a0a0f;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#1a1a2e;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="accent" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#4da6ff;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0066cc;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="1024" height="1024" rx="220" fill="url(#bg)"/>
  <g transform="translate(512, 512)">
    <!-- Terminal window -->
    <rect x="-200" y="-160" width="400" height="320" rx="16" fill="#0d0d14" stroke="url(#accent)" stroke-width="3"/>
    <rect x="-190" y="-150" width="380" height="28" rx="8" fill="#1a1a2e"/>
    <circle cx="-165" cy="-136" r="8" fill="#ff5f57"/>
    <circle cx="-135" cy="-136" r="8" fill="#ffbd2e"/>
    <circle cx="-105" cy="-136" r="8" fill="#28ca42"/>
    <!-- Prompt lines -->
    <text x="-180" y="-80" font-family="monospace" font-size="28" fill="#4da6ff" font-weight="bold">$</text>
    <text x="-150" y="-80" font-family="monospace" font-size="28" fill="#e0e0e0"> opencode</text>
    <text x="-180" y="-30" font-family="monospace" font-size="28" fill="#22c55e">✓</text>
    <text x="-150" y="-30" font-family="monospace" font-size="28" fill="#e0e0e0"> Conectado</text>
    <text x="-180" y="20" font-family="monospace" font-size="28" fill="#4da6ff">$</text>
    <text x="-150" y="20" font-family="monospace" font-size="28" fill="#e0e0e0"> pair --remote</text>
    <text x="-180" y="70" font-family="monospace" font-size="28" fill="#f97316">▲</text>
    <text x="-150" y="70" font-family="monospace" font-size="28" fill="#e0e0e0"> Escaneie o QR</text>
    <text x="-180" y="120" font-family="monospace" font-size="28" fill="#4da6ff">$</text>
    <text x="-150" y="120" font-family="monospace" font-size="28" fill="#e0e0e0"> _</text>
  </g>
</svg>